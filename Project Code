void uart_init(unsigned int baud) {
  unsigned int ubrr = 16000000 / 16 / baud - 1;
  *myUBRR0 = ubrr;
  *myUCSR0B = (1 << 3); 
  *myUCSR0C = (1 << 2) | (1 << 1); 
}

void uart_transmit(unsigned char data) {
  while (!(*myUCSR0A & (1 << 5))); 
  *myUDR0 = data;
}

void uart_print(const char* str) {
  while (*str) {
    uart_transmit(*str++);
  }
}

void uart_print_num(unsigned long num) {
  if (num == 0) {
    uart_transmit('0');
    return;
  }
  char buf[10];
  int i = 0;
  while (num > 0) {
    buf[i++] = (num % 10) + '0';
    num /= 10;
  }
  while (i > 0) {
    uart_transmit(buf[--i]);
  }
}

void twi_init() {
  *myTWSR = 0x00;
  *myTWBR = 72;
  *myTWCR = (1 << 2);
}

void twi_start() {
  *myTWCR = (1 << 7) | (1 << 5) | (1 << 2);
  unsigned int timeout = 10000;
  while(!(*myTWCR & (1 << 7)) && timeout > 0) {
      timeout--;
  }
  if (timeout == 0) return; 
}

void twi_stop() {
  *myTWCR = (1 << 7) | (1 << 4) | (1 << 2);
}

void twi_write(unsigned char data) {
  *myTWDR = data;
  *myTWCR = (1 << 7) | (1 << 2);
  unsigned int timeout = 10000;
  while(!(*myTWCR & (1 << 7)) && timeout > 0) {
      timeout--;
  }
}

unsigned char twi_read_ack() {
  *myTWCR = (1 << 7) | (1 << 6) | (1 << 2);
  unsigned int timeout = 10000;
  while(!(*myTWCR & (1 << 7)) && timeout > 0) {
      timeout--;
  }
  return *myTWDR;
}

unsigned char twi_read_nack() {
  *myTWCR = (1 << 7) | (1 << 2);
  unsigned int timeout = 10000;
  while(!(*myTWCR & (1 << 7)) && timeout > 0) {
      timeout--;
  }
  return *myTWDR;
}

unsigned char bcd_to_dec(unsigned char val) {
  return (val / 16 * 10) + (val % 16);
}

// NEW: Decimal to BCD converter for setting the time
unsigned char dec_to_bcd(unsigned char val) {
  return ((val / 10) * 16) + (val % 10);
}

// NEW: Function to write the time to the RTC
void setRTC(unsigned char hr, unsigned char min, unsigned char sec) {
  twi_start();
  twi_write(0xD0); 
  twi_write(0x00); 
  
  twi_write(dec_to_bcd(sec)); 
  twi_write(dec_to_bcd(min)); 
  twi_write(dec_to_bcd(hr));  
  
  twi_stop();
}

void printTimestamp() {
  twi_start();
  twi_write(0xD0);
  twi_write(0x00);
  twi_start();
  twi_write(0xD1);
  unsigned char sec = bcd_to_dec(twi_read_ack() & 0x7F);
  unsigned char min = bcd_to_dec(twi_read_ack());
  unsigned char hr = bcd_to_dec(twi_read_nack() & 0x3F);
  twi_stop();

  uart_print("[");
  uart_print_num(hr); uart_print(":");
  if(min < 10) uart_print("0"); 
  uart_print_num(min); uart_print(":");
  if(sec < 10) uart_print("0"); 
  uart_print_num(sec); 
  uart_print("] ");
}

void logEvent(const char* category, const char* details) {
  printTimestamp();
  uart_print(category);
  uart_print(": ");
  uart_print(details);
  uart_print("\r\n");
}

void changeState(GameState newState) {
  if (state != newState) {
    printTimestamp();
    uart_print("TRANSITION: ");
    uart_print(stateStrings[state]);
    uart_print(" -> ");
    uart_print(stateStrings[newState]);
    uart_print("\r\n");
    state = newState;
  }
}

void logPeriodicData() {
  if (millis() - lastLogTime >= 60000) {
    lastLogTime = millis();
    
    printTimestamp();
    uart_print("--- PERIODIC SYSTEM LOG ---\r\n");
    uart_print("WINS -> P1: "); uart_print_num(p1Wins);
    uart_print(" | P2: "); uart_print_num(p2Wins);
    uart_print(" | P3: "); uart_print_num(p3Wins);
    uart_print(" | P4: "); uart_print_num(p4Wins);
    uart_print("\r\nLast Reaction: "); 
    uart_print_num(lastReaction); 
    uart_print(" ms\r\n");
    uart_print("Current State: ");
    uart_print(stateStrings[state]);
    uart_print("\r\n---------------------------\r\n");
  }
}

void my_delay(unsigned int freq) {
  double period = 1.0/double(freq);
  double half_period = period/2;
  double clk_period = 0.0000000625;
  unsigned int ticks = half_period/clk_period;
  
  *myTCCR1B &= 0xF8;
  *myTCNT1 = (unsigned int) (65536 - ticks);
  *myTCCR1A = 0x0;
  *myTCCR1B |= 0x01;
  
  while((*myTIFR1 & 0x01)==0); 
  
  *myTCCR1B &= 0xF8;   
  *myTIFR1 |= 0x01;
}

void timer1_delay_us(uint16_t us) {
  TCNT1 = 0;
  uint16_t ticks = us * 2;
  while (TCNT1 < ticks);
}

void timer1_delay_ms(uint16_t ms) {
  for (uint16_t i = 0; i < ms; i++) {
    timer1_delay_us(1000);
  }
}

uint16_t adc_read(uint8_t channel) {
  ADMUX = (ADMUX & 0xF8) | (channel & 0x07); 
  ADCSRA |= (1 << ADSC);
  while (ADCSRA & (1 << ADSC));
  return ADC;
}

byte readAnalogAxisLevel(uint8_t channel) {
  return (adc_read(channel) >> 2);
}

bool isAnalogButtonPressed() {
  return !(PINF & (1 << SW_BIT));
}

void setup() {
  uart_init(9600);

  TCCR1A = 0;
  TCCR1B = (1 << CS11);
  TCNT1 = 0;

  *ddr_f &= ~(0x01 << SW_BIT);
  *port_f |= (1 << SW_BIT);

  ADMUX = (1 << REFS0);
  ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);

  *ddr_a |= 0x01 << 0;
  *ddr_a |= 0x01 << 1;
  *ddr_a |= 0x01 << 2;
  *ddr_a |= 0x01 << 3;

  *ddr_b |= 0x01 << 4;
  *ddr_b |= 0x01 << 5;
  *ddr_b |= 0x01 << 6;
  
  *ddr_h |= 0x01 << 5;
  *ddr_h |= 0x01 << 6;

  *ddr_a &= ~(0x01 << 4);
  *port_a |= (0x01 << 4);
  *ddr_a &= ~(0x01 << 5);
  *port_a |= (0x01 << 5);
  *ddr_a &= ~(0x01 << 6);
  *port_a |= (0x01 << 6);
  *ddr_a &= ~(0x01 << 7);
  *port_a |= (0x01 << 7);

  *ddr_c &= ~(0x01 << 7);
  *port_c |= (0x01 << 7);
  *ddr_c &= ~(0x01 << 3);
  *port_c |= (0x01 << 3);

  *ddr_d &= ~(0x01 << 2);
  *port_d |= (0x01 << 2);

  lcd.begin(16, 2);

  TCCR2A = 0;
  TCCR2B = 0;
  TCCR2A |= (1 << COM2B1) | (1 << WGM21) | (1 << WGM20);
  TCCR2B |= (1 << CS22);
  OCR2B = 0;
  
  twi_init();

  // ========================================================
  // RTC SETUP: Change the numbers to the exact current time
  // FORMAT: setRTC(Hour_24, Minute, Second);
  // Example: 3:00 PM is 15, 0, 0
  //
  // 1. Upload this code once to set the time.
  // 2. Put // in front of setRTC and upload AGAIN!
  // ========================================================
  
  setRTC(15, 0, 0); 
  
  logEvent("SYSTEM", "Boot successful.");
}

void checkGlobalButtons() {
  static bool systemCurrentlyOff = false;
  static bool buttonWasPressed = false; 
  
  bool buttonIsPressed = !(*pin_d & (0x01 << 2));

  if (buttonIsPressed && !buttonWasPressed) { 
    if (!systemCurrentlyOff) {
      lcd.clear();
      *port_a &= ~(0x0F); 
      *port_b &= ~((0x01 << 4) | (0x01 << 5) | (0x01 << 6)); 
      *port_h &= ~((0x01 << 5) | (0x01 << 6)); 
      changeState(SYSTEM_OFF);
      logEvent("HARDWARE", "Main Button Pressed (System Sleep)");
      systemCurrentlyOff = true;
    } else {
      lcd.clear();
      *port_b |= (0x01 << 6); 
      
      lcd.print("START: BTN");
      lcd.setCursor(0, 1);
      if (fanModeEnabled) {
        lcd.print("FAN: ON (Prs B)");
      } else {
        lcd.print("FAN: OFF(Prs B)");
      }
      
      startDrawn = true;
      playerDrawn = false;
      roundScreenDrawn = false;
      gameStarted = false;
      winnerDrawn = false;
      errorDrawn = false;
      
      changeState(WAIT_START);
      logEvent("HARDWARE", "Main Button Pressed (System Wake)");
      systemCurrentlyOff = false;
    }
    timer1_delay_ms(200); 
  }

  buttonWasPressed = buttonIsPressed;

  if (systemCurrentlyOff) {
    return;
  }

  if (!(*pin_c & (0x01 << 7))) {
    if (state != SYSTEM_OFF && state != SELECT_PLAYERS) {
       lcd.clear();
       currentRound = 1;

       startDrawn = false;
       playerDrawn = false;
       roundScreenDrawn = false;
       gameStarted = false;
       winnerDrawn = false;
       errorDrawn = false;
       
       logEvent("HARDWARE", "Reset Button Pressed");
       changeState(SELECT_PLAYERS);
    }
  }
}

void handleSystemOff() {
  *port_b |= (0x01 << 6);
  lcd.clear();
  lcd.begin(16, 2);
}

void handleError() {
  static unsigned long errorStartTime = 0;

  if (!errorDrawn) {
    OCR2B = 0; 
    *port_b &= ~(0x01 << 5);
    *port_h &= ~(0x01 << 5);
    *port_a &= ~(0x0F); 

    *port_b |= (0x01 << 6);  
    *port_b |= (0x01 << 4);  

    lcd.clear();
    lcd.print("FAULT DETECTED!");
    lcd.setCursor(0, 1);
    lcd.print("Restarting...");
    
    logEvent("ERROR", "Fault State Displayed to User");
    
    errorStartTime = millis();
    errorDrawn = true;
  }

  if (millis() - errorStartTime >= 3000) {
    errorDrawn = false;
    
    *port_b &= ~(0x01 << 6);
    *port_b &= ~(0x01 << 4);
    
    currentRound = 0;
    lcd.clear();
    startDrawn = false;
    changeState(WAIT_START);
  }
}

void updateFanSpeed() {
  static bool fanIsCurrentlyOn = false; 
  
  if (fanModeEnabled && state == WAIT_START) {
    byte y_val = readAnalogAxisLevel(VRY_CH); 

    if (y_val > 140) {
      int speed = (y_val - 140) * 2;
      if (speed > 255) speed = 255;
      OCR2B = speed; 
      if (!fanIsCurrentlyOn) { logEvent("ACTUATOR", "Fan PWM Started (Forward)"); fanIsCurrentlyOn = true; }
    } 
    else if (y_val < 110) {
      int speed = (110 - y_val) * 2;
      if (speed > 255) speed = 255;
      OCR2B = speed;
      if (!fanIsCurrentlyOn) { logEvent("ACTUATOR", "Fan PWM Started (Reverse)"); fanIsCurrentlyOn = true; }
    } 
    else {
      OCR2B = 0; 
      if (fanIsCurrentlyOn) { logEvent("ACTUATOR", "Fan PWM Stopped"); fanIsCurrentlyOn = false; }
    }
  } else {
    OCR2B = 0; 
    if (fanIsCurrentlyOn) { logEvent("ACTUATOR", "Fan PWM Disabled (State changed)"); fanIsCurrentlyOn = false; }
  }
}

bool startButtonPressed() {
  if(!(*pin_c & (0x01 << 3))) {
    timer1_delay_ms(500);
    return true;
  }
  return false;
}

void handleStart() {  
  *port_b &= ~(0x01 << 6);
  *port_b |= (0x01 << 4);
  if (!startDrawn) {
    *port_a &= ~(0x0F); 
    lcd.clear();
    lcd.print("START: BTN");
    lcd.setCursor(0, 1);
    
    if (fanModeEnabled) {
      lcd.print("FAN: ON (Prs B)");
    } else {
      lcd.print("FAN: OFF(Prs B)");
    }
    startDrawn = true;
  }

  char key = keypad.getKey();
  if (key == 'B') {
    fanModeEnabled = !fanModeEnabled;
    startDrawn = false;
    logEvent("SETTINGS", fanModeEnabled ? "Fan Mode Enabled" : "Fan Mode Disabled");
  }

  if (startButtonPressed()) {
    *port_b &= ~(0x01 << 4);
    *port_h |= (0x01 << 5);
    startDrawn = false;
    changeState(SELECT_PLAYERS);
  }
}

void handlePlayerSelect() {
  if (!playerDrawn) {
    lcd.clear();
    lcd.print("PLAYERS 1-4:");
    playerDrawn = true;
  }
  
  char key = keypad.getKey();
  if (key >= '1' && key <= '4') {
    numPlayers = key - '0';
    lcd.clear();
    lcd.print("PLAYERS: ");
    lcd.print(numPlayers);
    timer1_delay_ms(2000);
    
    playerDrawn = false;
    logEvent("SETTINGS", "Player Count Confirmed");
    changeState(SELECT_ROUNDS);
  }
}

void handleRoundSelect() {
  if (!roundScreenDrawn) {
    lcd.clear();
    lcd.print("ROUNDS 1-9: ");
    roundScreenDrawn = true;
  }
  
  char key = keypad.getKey();
  if (key >= '1' && key <= '9') {
    numRounds = key - '0';
    currentRound = 1;
    
    lcd.clear();
    lcd.print("ROUNDS: ");
    lcd.print(numRounds);
    timer1_delay_ms(2000);
    
    roundScreenDrawn = false;
    logEvent("SETTINGS", "Round Count Confirmed");
    changeState(COUNTDOWN);
  }
}

void handleCountdown() {
  *port_b &= ~(0x01 << 6);
  
  for(int i = 10; i >= 0; i--) {
    byte early_snapshot = *pin_a; 
    if (!(early_snapshot & (0x01 << 4)) || !(early_snapshot & (0x01 << 5)) || 
        !(early_snapshot & (0x01 << 6)) || !(early_snapshot & (0x01 << 7))) {
      
      lcd.clear();
      lcd.print("FALSE START!");
      timer1_delay_ms(1500);
      
      logEvent("ERROR", "False start triggered during countdown");
      changeState(ERROR_STATE);
      return;
    }

    lcd.clear();
    lcd.print("ROUND BEGINS: ");
    lcd.print(i);
    timer1_delay_ms(500);
    *port_h |= (0x01 << 5); 
    timer1_delay_ms(500);
    *port_h &= ~(0x01 << 5); 
  }
  
  *port_h |= (0x01 << 5);
  changeState(WAIT_FOR_REACTION);
}

void handleReactionGame() {
  static unsigned long startTime = 0;

  if (!gameStarted) {
    lcd.clear();
    lcd.print("GO!");
    
    logEvent("ACTUATOR", "Buzzer sequence started");
    for(int i = 0; i < 100; i++){ 
        *port_b |= (0x01 << 5);
        my_delay(750);
        *port_b &= ~(0x01 << 5);
        my_delay(750);
        
        byte early_snapshot = *pin_a; 
        if (!(early_snapshot & (0x01 << 4)) || !(early_snapshot & (0x01 << 5)) || 
            !(early_snapshot & (0x01 << 6)) || !(early_snapshot & (0x01 << 7))) {
          break; 
        }
    }
      TCCR1A = 0;
      TCCR1B = (1<< CS11);

      startTime = millis(); 
      gameStarted = true;
  }

  byte portA_snapshot = *pin_a; 

  bool p1_pressed = !(portA_snapshot & (0x01 << 4));
  bool p2_pressed = !(portA_snapshot & (0x01 << 5));
  bool p3_pressed = !(portA_snapshot & (0x01 << 6));
  bool p4_pressed = !(portA_snapshot & (0x01 << 7));

  if (p1_pressed || p2_pressed || p3_pressed || p4_pressed) {
    unsigned long reactionTime = millis() - startTime;
    lastReaction = reactionTime;
    
    if (p1_pressed) player = 1;
    else if (p2_pressed) player = 2;
    else if (p3_pressed) player = 3;
    else if (p4_pressed) player = 4;

    lcd.clear();
    lcd.print("TIME: ");
    lcd.print(reactionTime);
    lcd.print(" ms");
    
    logEvent("GAMEPLAY", "Player reacted to prompt");
    timer1_delay_ms(1500); 

    gameStarted = false; 
    changeState(SHOW_WINNER);
  }
}

void handleWinner() {
  static unsigned long displayStartTime = 0;

  if (!winnerDrawn) {
    if (player == 1) {
      *port_a |= (0x01 << 0);
      p1Wins++;
      logEvent("ACTUATOR", "P1 Win LED ON");
    } else if (player == 2) {
      *port_a |= (0x01 << 1);
      p2Wins++;
      logEvent("ACTUATOR", "P2 Win LED ON");
    } else if (player == 3) {
      *port_a |= (0x01 << 2);
      p3Wins++;
      logEvent("ACTUATOR", "P3 Win LED ON");
    } else if (player == 4) {
      *port_a |= (0x01 << 3);
      p4Wins++;
      logEvent("ACTUATOR", "P4 Win LED ON");
    }

    lcd.clear();
    lcd.print("PLAYER ");
    lcd.print(player);
    lcd.print(" WINS RND ");
    lcd.print(currentRound);
    
    displayStartTime = millis();
    winnerDrawn = true;
  }

  if (millis() - displayStartTime >= 3000) {
    winnerDrawn = false;
    *port_a &= ~(0x0F); 
    logEvent("ACTUATOR", "Win LEDs Disabled");
    
    if (currentRound < numRounds) {
      currentRound++;
      changeState(COUNTDOWN); 
    } else {
      lcd.clear();
      lcd.print("GAME OVER!");
      *port_h &= ~(0x01 << 5);
      timer1_delay_ms(2000);
      
      startDrawn = false;
      changeState(WAIT_START); 
    }
  }
}

void loop() {
  checkGlobalButtons();
  updateFanSpeed();
  logPeriodicData(); 
  
  switch(state){
    case WAIT_START:
      handleStart();
      break;
    case SELECT_PLAYERS:
      handlePlayerSelect();
      break;
    case SELECT_ROUNDS:
      handleRoundSelect();
      break;
    case COUNTDOWN:
      handleCountdown();
      break;
    case WAIT_FOR_REACTION:
      handleReactionGame();
      break;
    case SHOW_WINNER:
      handleWinner();
      break;
    case SYSTEM_OFF:
      handleSystemOff();
      break;
    case ERROR_STATE:
      handleError();
      break;
  }
}
