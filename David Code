#include <LiquidCrystal.h>
#include <Keypad.h>

// --- Hardware Setup ---
const int rs = 2, en = 3, d4 = 4, d5 = 5, d6 = 6, d7 = 7;
LiquidCrystal lcd(rs, en, d4, d5, d6, d7);

const byte ROWS = 4; 
const byte COLS = 4; 
char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};
byte rowPins[ROWS] = {53, 52, 51, 50}; 
byte colPins[COLS] = {49, 48, 47, 46}; 
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// --- Game State Machine ---
enum GameState { STATE_OFF, STATE_IDLE_PLAYERS, STATE_IDLE_MODE, STATE_ON };
volatile GameState currentState = STATE_OFF; 

// --- Game Variables ---
int playerCount = 0;
char gameMode = ' ';
volatile bool lcdNeedsUpdate = true; 

// Button tracking variables
bool lastResetState = true; 

// Variables for the LED Chaser 
unsigned long previousMillis = 0;
const long chaserInterval = 150; 
int currentCornerLed = 0;

void setup() {
  // 1. Register-Level Output Configuration
  
  // Set Main LEDs to OUTPUT: Red (PH6), Green (PH5)
  DDRH |= (1 << PH6) | (1 << PH5); 
  
  // Set Blue LED (PB4) and Buzzer (PB5) to OUTPUT
  DDRB |= (1 << PB4) | (1 << PB5); 
  
  // Set Fan (Pin 32 / PC5) to OUTPUT
  DDRC |= (1 << PC5);

  // Set Corner LEDs (PA0 to PA3) to OUTPUT
  DDRA |= 0x0F; 

  // 2. Register-Level Input Configuration
  
  // Set ON Button (Pin 18 / PD3) to INPUT with PULLUP
  DDRD &= ~(1 << PD3); 
  PORTD |= (1 << PD3); 
  
  // Set OFF Button (Pin 19 / PD2) to INPUT with PULLUP
  DDRD &= ~(1 << PD2);
  PORTD |= (1 << PD2);

  // Set RESET Button (Pin 30 / PC7) to INPUT with PULLUP
  DDRC &= ~(1 << PC7);
  PORTC |= (1 << PC7);

  // 3. System Reset & Actuator Shutdown
  PORTC &= ~(1 << PC5); // Fan OFF
  PORTB &= ~(1 << PB5); // Buzzer OFF

  // Clear pending interrupt flags
  EIFR |= (1 << INTF3) | (1 << INTF2); 
  
  // Attach Hardware Interrupts
  attachInterrupt(digitalPinToInterrupt(18), powerOnISR, FALLING);
  attachInterrupt(digitalPinToInterrupt(19), powerOffISR, FALLING);

  // 4. Start LCD and setup initial state
  lcd.begin(16, 2);
  lcdNeedsUpdate = true; // Force the OFF state logic to run once
}

// --- Interrupt Service Routines (ISRs) ---
void powerOnISR() {
  if (currentState == STATE_OFF) {
    currentState = STATE_IDLE_PLAYERS;
    lcdNeedsUpdate = true; 
  }
}

void powerOffISR() {
  if (currentState != STATE_OFF) {
    currentState = STATE_OFF;
    lcdNeedsUpdate = true; 
  }
}

// --- Helper Functions ---
void enterOffState() {
  PORTB &= ~((1 << PB4) | (1 << PB5)); // Blue OFF, Buzzer OFF
  PORTC &= ~(1 << PC5);                // Fan OFF
  PORTH &= ~(1 << PH5);                // Green OFF
  PORTA &= ~0x0F;                      // Corner LEDs OFF

  PORTH |= (1 << PH6);                 // Red ON 

  lcd.clear();
  lcd.noDisplay(); 
}

void runLedChaser() {
  unsigned long currentMillis = millis();
  
  if (currentMillis - previousMillis >= chaserInterval) { 
    previousMillis = currentMillis;
    PORTA &= ~0x0F; 
    PORTA |= (1 << currentCornerLed); 
    
    currentCornerLed++;
    if (currentCornerLed > 3) {
      currentCornerLed = 0;
    }
  }
}

// --- Main Program Loop ---
void loop() {

  // --- 1. Global Reset Button Check ---
  // If the game is running (not OFF), we check if the Reset Button (Pin 30 / PC7) is pressed
  if (currentState != STATE_OFF) {
    bool currentResetState = (PINC & (1 << PC7)); // Reads HIGH if unpressed, LOW if pressed
    
    // If it just transitioned to LOW (pressed)
    if (currentResetState == 0 && lastResetState != 0) {
      currentState = STATE_IDLE_PLAYERS;
      lcdNeedsUpdate = true;
      
      // Shut down any active game hardware immediately
      PORTB &= ~(1 << PB5); // Buzzer OFF
      PORTC &= ~(1 << PC5); // Fan OFF
      PORTH &= ~(1 << PH5); // Green OFF
    }
    lastResetState = currentResetState; // Update for next loop
  }

  // --- 2. State Machine Logic ---
  switch (currentState) {
    
    case STATE_OFF:
      // We handle the hardware shutdown here so it only triggers once
      if (lcdNeedsUpdate) {
        enterOffState();
        lcdNeedsUpdate = false;
      }
      break;

    // ---> THIS IS THE MISSING BLOCK <---
    case STATE_IDLE_PLAYERS:
      if (lcdNeedsUpdate) {
        PORTH &= ~(1 << PH6); // Turn OFF Red LED
        PORTB |= (1 << PB4);  // Turn ON Blue LED
        
        lcd.display(); 
        lcd.clear();
        lcd.print("Player Count:");
        lcd.setCursor(0, 1);
        lcd.print("Press 1, 2, 3, 4");
        lcdNeedsUpdate = false;
      }

      runLedChaser();

      char key = keypad.getKey();
      if (key >= '1' && key <= '4') {
        playerCount = key - '0'; 
        currentState = STATE_IDLE_MODE; 
        lcdNeedsUpdate = true;          
      }
      break;
    // ------------------------------------

    case STATE_IDLE_MODE:
      // 1. Draw the UI and set the static LEDs (Runs once)
      if (lcdNeedsUpdate) {
        lcd.clear();
        lcd.print("Select Mode:");
        lcd.setCursor(0, 1);
        lcd.print("A:Last Man B:Rnd");

        // --- NEW: Player Count LED Logic ---
        PORTA &= ~0x0F; // Turn off all corner LEDs first to wipe the chaser cleanly

        if (playerCount == 1) {
          PORTA |= 0x01; // Turn on Corner LED 1
        } else if (playerCount == 2) {
          PORTA |= 0x03; // Turn on Corner LEDs 1, 2
        } else if (playerCount == 3) {
          PORTA |= 0x07; // Turn on Corner LEDs 1, 2, 3
        } else if (playerCount == 4) {
          PORTA |= 0x0F; // Turn on Corner LEDs 1, 2, 3, 4
        }
        
        lcdNeedsUpdate = false;
      }

      // NOTE: runLedChaser() has been completely removed from this state!

      // 2. Listen for Mode Selection Input
      char modeKey = keypad.getKey();
      if (modeKey == 'A' || modeKey == 'B') {
        gameMode = modeKey;
        currentState = STATE_ON; 
        lcdNeedsUpdate = true;
      }
      break;

    case STATE_ON:
      if (lcdNeedsUpdate) {
        PORTB &= ~(1 << PB4); // Blue OFF
        PORTA &= ~0x0F;       // Corner LEDs OFF
        PORTH |= (1 << PH5);  // Green ON 
        
        lcd.clear();
        lcd.print("Game Starting!");
        lcdNeedsUpdate = false;
      }
      break;
  }
}
