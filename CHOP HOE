}
int cnt = 1000;
void handleCountdown(){
  *port_b &= ~(0x01 << 6); //RED LED OFF
  for(int i = 10; i >= 0; i--){
    *port_h &= ~(0x01 << 5);
    lcd.clear();
    lcd.print("ROUND BEGINS: ");
    lcd.print(i);
    timer1_delay_ms(cnt);
    *port_h |= (0x01 << 5); //(Led GREEN - HIGH)
    timer1_delay_ms(cnt);
  }
  *port_h |= (0x01 << 5); //(Led GREEN - HIGH)
  state = WAIT_FOR_REACTION;
}
